# 复制成 .env 再填写。.env 不会进 git。
PORT=3000

# 管理页密码：打开 https://你的域名/admin?key=这里的值 可以看到谁已经寄了
ADMIN_KEY=换成一串只有你知道的字符

# Joey 看的页面：https://你的域名/for-joey/这里的值 （留空的话安装脚本会自动生成）
VIEW_KEY=

# Cloudflare R2（R2 页面 → Manage API Tokens 里拿到）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=joey-birthday

# 可选：腾讯云 COS（大陆地域），只存视频播放版，让在大陆的 Joey 下载更快。不填就不启用。
# COS_BUCKET 是完整的存储桶名（带 -APPID 后缀），COS_REGION 例如 ap-shanghai、ap-guangzhou、ap-beijing
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
